# Production environment configuration
# Copy to .env.production and fill in actual values
# These are injected by deploy workflows - do not commit real IPs

# Build-time variables (VITE_ prefix required for Vite to embed in bundle):
VITE_GRAPHQL_URL=http://YOUR_HOST_IP:4000/graphql
VITE_BRIDGE_URL=http://YOUR_HOST_IP:3030
VITE_INDEXER_URL=http://YOUR_HOST_IP:3031

# Runtime variables (Docker only - injected by docker-entrypoint.sh):
# GRAPHQL_URL, BRIDGE_URL, INDEXER_URL (no VITE_ prefix)
# These override build-time values via public/config.js injection

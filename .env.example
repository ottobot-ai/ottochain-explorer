# OttoChain Explorer Environment
# Copy to .env.local for local development: cp .env.example .env.local

# Local dev requires direct URLs (not nginx proxy paths)
VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_BRIDGE_URL=http://localhost:3030
VITE_INDEXER_URL=http://localhost:3031

# Explorer port (for docker compose)
EXPLORER_PORT=8080
